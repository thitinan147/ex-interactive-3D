# Canonical public URL (used by sitemap + Open Graph absolute image URLs)
PUBLIC_SITE_URL=https://your-project.pages.dev

# Formspree form endpoint for waitlist
# Create a form at https://formspree.io → copy endpoint like:
# https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_ENDPOINT=

# Optional: override local Grok reel (public/videos/launch-reel.mp4) with Vimeo
# https://vimeo.com/{id}  or  https://vimeo.com/{id}/{hash}
PUBLIC_VIMEO_ID=
PUBLIC_VIMEO_HASH=

# Cloudflare Web Analytics beacon token (optional, privacy-friendly)
# Dashboard → Web Analytics → site token
PUBLIC_CF_BEACON=
