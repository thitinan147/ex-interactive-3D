---
interface Props {
  hasReel?: boolean;
}
const { hasReel = true } = Astro.props;
---

<section class="o-section" id="reel">
  <div class="o-container">
    <div class="o-section__inner">
      <p class="o-kicker js-reveal">Launch reel</p>
      <h2 class="o-title o-title--sm js-reveal">See the stack leave the pad.</h2>
      <p class="o-body js-reveal">
        {
          hasReel
            ? "18s awe reel — monumental scale, ignition, heroic orbit. Fullscreen overlay; Escape to close."
            : "Add a local reel under public/videos or set PUBLIC_VIMEO_ID."
        }
      </p>
      <div class="btn-row js-reveal">
        <button
          class="btn btn--primary is-interactive"
          type="button"
          data-open-reel
          data-track="reel_cta"
          data-track-label="Play reel"
        >
          Play pad film
        </button>
      </div>
    </div>
  </div>
</section>
