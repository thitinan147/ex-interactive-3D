<section class="o-section" id="order">
  <div class="o-container">
    <div class="o-section__inner">
      <p class="o-kicker">Pre-order / waitlist</p>
      <h2 class="o-title o-title--sm">Reserve a flight slot.</h2>
      <p class="o-body o-body--wide">
        Register interest for V-9 manifests. No payment collected on this demo — wire Mailchimp or your CRM next.
      </p>
      <form class="order-form" id="order-form">
        <label>
          Work email
          <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        </label>
        <label>
          Preferred configuration
          <select name="variant">
            <option value="standard">V-9 Standard</option>
            <option value="heavy">V-9 Heavy</option>
            <option value="reusable">V-9 Reusable</option>
          </select>
        </label>
        <button class="btn btn--primary" type="submit">Join waitlist</button>
      </form>
    </div>
  </div>
</section>
