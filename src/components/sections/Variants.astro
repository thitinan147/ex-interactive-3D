<section class="o-section" id="variants">
  <div class="o-container">
    <div class="o-section__inner o-section__inner--wide">
      <p class="o-kicker js-reveal">Configure</p>
      <h2 class="o-title o-title--sm js-reveal">Pick the stack that matches your mission.</h2>
      <p class="o-body o-body--wide js-reveal">
        Click a variant to recolor the flight article. Full payload adapters ship with every kit.
      </p>
      <div class="variant-grid js-reveal">
        <button class="variant-card is-active is-interactive" type="button" data-variant="standard">
          <h3>V-9 Standard</h3>
          <p>Constellation deploy and LEO logistics. Balanced mass-to-orbit.</p>
          <div class="price">From $42M / flight</div>
        </button>
        <button class="variant-card is-interactive" type="button" data-variant="heavy">
          <h3>V-9 Heavy</h3>
          <p>Higher thrust margin and extended fairing for bulk cargo.</p>
          <div class="price">From $68M / flight</div>
        </button>
        <button class="variant-card is-interactive" type="button" data-variant="reusable">
          <h3>V-9 Reusable</h3>
          <p>Flight-proven recovery kit with priority turnaround SLA.</p>
          <div class="price">From $29M / flight</div>
        </button>
      </div>
    </div>
  </div>
</section>
