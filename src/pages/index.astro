---
import "../styles/global.css";
import Preloader from "../components/Preloader.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/sections/Hero.astro";
import Systems from "../components/sections/Systems.astro";
import Variants from "../components/sections/Variants.astro";
import Specs from "../components/sections/Specs.astro";
import Reel from "../components/sections/Reel.astro";
import Order from "../components/sections/Order.astro";
import Footer from "../components/sections/Footer.astro";
import { absoluteUrl, siteConfig } from "../lib/site";

const canonical = absoluteUrl("/", Astro.site);
const ogImage = absoluteUrl(siteConfig.ogImagePath, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteConfig.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0d10" />
    <link rel="canonical" href={canonical} />
    <title>{siteConfig.title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={siteConfig.title} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vektor V-9 reusable orbital rocket" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteConfig.title} />
    <meta name="twitter:description" content={siteConfig.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <canvas id="canvas" aria-hidden="true"></canvas>

    <div id="ui">
      <Preloader />
      <SiteHeader />
      <main id="pages-container">
        <Hero />
        <Systems />
        <Variants />
        <Specs />
        <Reel />
        <Order />
        <Footer />
      </main>
      <div id="scroll-indicator">Scroll to continue</div>
    </div>

    <div id="video-overlay" hidden>
      <button class="video-overlay__close is-interactive" type="button" data-close-reel>
        Close
      </button>
      <div class="video-overlay__frame">
        Vimeo player slot · wire reel in Phase 6
      </div>
    </div>

    <script src="../main.ts"></script>
  </body>
</html>
